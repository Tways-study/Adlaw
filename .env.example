# Adlaw environment variables — copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* values are exposed to the browser bundle by design (Firebase's
# web config is not secret). Everything else is server-only — it must NEVER be
# prefixed NEXT_PUBLIC_, or the key leaks into the client bundle.

# ── Firebase (required) ──────────────────────────────────────────────────────
# From Firebase console → Project settings → Your apps → Web app. All six are
# required before the app hydrates in the browser: firebase/client.ts throws
# synchronously on a missing/malformed key, which breaks every route including
# the public landing page.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── AI / Gemini (optional — Slice 7) ─────────────────────────────────────────
# Server-only. With GEMINI_API_KEY set, capture/breakdown/focus use Gemini;
# without it they fall back to the heuristic parser (no error). Free tier:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Overrides the default Gemini model (gemini-2.0-flash). Optional.
AI_MODEL=

# ── Google Calendar OAuth (optional — Slice 6) ───────────────────────────────
# Server-only. From a Google Cloud OAuth 2.0 Client (Web application), with the
# authorized redirect URI set to <origin>/api/calendar/callback. Without these,
# "Connect Google Calendar" degrades to a not-configured settings state rather
# than erroring; the board stays fully correct on the manual schedule alone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only. base64-encoded 32-byte key encrypting the Calendar refresh token
# at rest (AES-256-GCM). Also required to start the OAuth flow. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
