rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'title','rawText','courseId','estimateMin','dueAt','status',
               'laneOrder','parentId','stepIndex','parseState',
               'excludedFromFocusUntil','createdAt','completedAt'
             ])
          && request.resource.data.keys().hasAll(
               ['title','rawText','estimateMin','status','laneOrder','parseState','createdAt'])
          && request.resource.data.title is string
          && request.resource.data.rawText is string
          && request.resource.data.estimateMin is number
          && request.resource.data.estimateMin > 0
          && request.resource.data.status in ['shelf','next','now','done']
          && request.resource.data.laneOrder is number
          && request.resource.data.parseState in ['ok','fallback','failed']
          && request.resource.data.createdAt is number
          && (request.resource.data.status == 'done')
             == ('completedAt' in request.resource.data);

        allow update: if isOwner(uid)
          && request.resource.data.rawText == resource.data.rawText
          && request.resource.data.estimateMin is number
          && request.resource.data.estimateMin > 0
          && request.resource.data.status in ['shelf','next','now','done']
          && request.resource.data.parseState in ['ok','fallback','failed']
          && (request.resource.data.status == 'done')
             == ('completedAt' in request.resource.data);
      }

      match /courses/{courseId} {
        allow read, write: if isOwner(uid);
      }

      // Schema-only stubs (Slices 4/6/7/8, not built) — ownership-only rules
      // for forward compatibility. No field validation yet; add it in the
      // slice that starts writing to these.
      match /scheduleBlocks/{blockId} { allow read, write: if isOwner(uid); }
      match /calendarCache/{eventId} { allow read, write: if isOwner(uid); }
      match /aiLog/{logId}           { allow read, write: if isOwner(uid); }
      match /settings/{docId}        { allow read, write: if isOwner(uid); }
    }
  }
}
