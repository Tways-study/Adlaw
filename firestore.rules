rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'title','rawText','courseId','estimateMin','dueAt','status',
               'laneOrder','parentId','stepIndex','parseState',
               'excludedFromFocusUntil','createdAt','completedAt'
             ])
          && request.resource.data.keys().hasAll(
               ['title','rawText','estimateMin','status','laneOrder','parseState','createdAt'])
          && request.resource.data.title is string
          && request.resource.data.rawText is string
          && request.resource.data.estimateMin is number
          && request.resource.data.estimateMin > 0
          && request.resource.data.status in ['shelf','next','now','done']
          && request.resource.data.laneOrder is number
          && request.resource.data.parseState in ['ok','fallback','failed']
          && request.resource.data.createdAt is number
          && (request.resource.data.status == 'done')
             == ('completedAt' in request.resource.data);

        // Held to the same field set and field types as create. Without the
        // hasOnly, an authenticated user could attach arbitrary extra keys to
        // their own task documents — up to Firestore's 1 MiB per document,
        // which is storage abuse against a free-tier project. Without the
        // type checks, laneOrder could be set to a non-number, breaking
        // core/order.ts's arithmetic for that board. createdAt is pinned to
        // its stored value: it records when the task was captured, and an
        // update is never the moment to change that. scheduleBlocks below
        // has validated both create and update from the start; this brings
        // tasks to the same standard.
        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'title','rawText','courseId','estimateMin','dueAt','status',
               'laneOrder','parentId','stepIndex','parseState',
               'excludedFromFocusUntil','createdAt','completedAt'
             ])
          && request.resource.data.keys().hasAll(
               ['title','rawText','estimateMin','status','laneOrder','parseState','createdAt'])
          && request.resource.data.title is string
          && request.resource.data.rawText == resource.data.rawText
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.estimateMin is number
          && request.resource.data.estimateMin > 0
          && request.resource.data.status in ['shelf','next','now','done']
          && request.resource.data.laneOrder is number
          && request.resource.data.parseState in ['ok','fallback','failed']
          && (request.resource.data.status == 'done')
             == ('completedAt' in request.resource.data);
      }

      match /courses/{courseId} {
        allow read, delete: if isOwner(uid);

        // The auto-create path (firebase/tasks.ts's resolveCourseId, run
        // inside a writeBatch alongside the task it's resolving a
        // courseCode for) writes exactly { code, active: true } — no
        // `name`, which core/types.ts's Course carries but nothing in ui/
        // reads or writes today (see the plan's "Course rename edits code"
        // decision). Both create and update accept the same shape, matching
        // scheduleBlocks/aiLog's convention of parity between the two.
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['code','name','active'])
          && request.resource.data.keys().hasAll(['code','active'])
          && request.resource.data.code is string
          && (!('name' in request.resource.data) || request.resource.data.name is string)
          && request.resource.data.active is bool;

        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['code','name','active'])
          && request.resource.data.keys().hasAll(['code','active'])
          && request.resource.data.code is string
          && (!('name' in request.resource.data) || request.resource.data.name is string)
          && request.resource.data.active is bool;
      }

      match /scheduleBlocks/{blockId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'weekday','startMin','endMin','label','kind','activeFrom','activeTo'
             ])
          && request.resource.data.keys().hasAll(
               ['weekday','startMin','endMin','label','kind','activeFrom'])
          && request.resource.data.weekday is number
          && request.resource.data.weekday >= 0
          && request.resource.data.weekday <= 6
          && request.resource.data.startMin is number
          && request.resource.data.endMin is number
          && request.resource.data.startMin >= 0
          && request.resource.data.startMin < request.resource.data.endMin
          && request.resource.data.endMin <= 1440
          && request.resource.data.label is string
          && request.resource.data.kind in ['class','work','commute','other']
          && request.resource.data.activeFrom is number
          && (!('activeTo' in request.resource.data)
              || request.resource.data.activeTo is number);

        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'weekday','startMin','endMin','label','kind','activeFrom','activeTo'
             ])
          && request.resource.data.keys().hasAll(
               ['weekday','startMin','endMin','label','kind','activeFrom'])
          && request.resource.data.weekday is number
          && request.resource.data.weekday >= 0
          && request.resource.data.weekday <= 6
          && request.resource.data.startMin is number
          && request.resource.data.endMin is number
          && request.resource.data.startMin >= 0
          && request.resource.data.startMin < request.resource.data.endMin
          && request.resource.data.endMin <= 1440
          && request.resource.data.label is string
          && request.resource.data.kind in ['class','work','commute','other']
          && request.resource.data.activeFrom is number
          && (!('activeTo' in request.resource.data)
              || request.resource.data.activeTo is number);
      }

      // Schema-only stub (Slice 6, not built) — ownership-only rule for
      // forward compatibility. No field validation yet; add it in the slice
      // that starts writing to it.
      match /calendarCache/{eventId} { allow read, write: if isOwner(uid); }

      // aiLog (Slice 7). Written by the client, not a Route Handler — there
      // is no Admin SDK/service account in this project, so app/api/ai/*
      // returns the log payload and firebase/aiLog.ts writes it here with
      // the caller's own auth. Append-only: entries are never edited, only
      // ever created or (via data export/cleanup) deleted.
      match /aiLog/{logId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'kind','input','output','provider','model','ok','error','latencyMs','createdAt'
             ])
          && request.resource.data.keys().hasAll(
               ['kind','input','provider','model','ok','latencyMs','createdAt'])
          && request.resource.data.kind in ['parse','breakdown','focus']
          && request.resource.data.input is string
          && (!('output' in request.resource.data) || request.resource.data.output is string)
          && request.resource.data.provider is string
          && request.resource.data.model is string
          && request.resource.data.ok is bool
          && (!('error' in request.resource.data) || request.resource.data.error is string)
          && request.resource.data.latencyMs is number
          && request.resource.data.latencyMs >= 0
          && request.resource.data.createdAt is number;

        allow update: if false;
      }

      // settings/prefs grows one field per slice (dayEndMin now; theme,
      // aiProvider, googleRefreshTokenEncrypted, … in Slices 6–8). No
      // hasOnly here on purpose — unlike scheduleBlocks, this doc's full
      // shape isn't introduced in one slice, so each slice validates only
      // the field it starts writing, per this file's existing convention.
      match /settings/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (!('dayEndMin' in request.resource.data)
              || (request.resource.data.dayEndMin is number
                  && request.resource.data.dayEndMin >= 0
                  && request.resource.data.dayEndMin <= 1440));
      }
    }
  }
}
